# Export selected variables; the CLI does not load this file.
# Embeddings run locally. Initial model acquisition downloads weights only.
MIMIR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MIMIR_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
MIMIR_EMBEDDING_DIMENSIONS=384
MIMIR_EMBEDDING_DEVICE=auto
MIMIR_EMBEDDING_WINDOW_TOKENS=512
MIMIR_EMBEDDING_INFERENCE_BATCH_SIZE=32
MIMIR_EMBEDDING_LOCAL_FILES_ONLY=false
MIMIR_SYNTHESIS_PROVIDER=claude-code
MIMIR_CHUNK_TARGET_TOKENS=450
MIMIR_CHUNK_MAX_TOKENS=700
MIMIR_CHUNK_OVERLAP_TOKENS=64
MIMIR_TOP_K=6
MIMIR_CONTEXT_TOKEN_BUDGET=6000
MIMIR_MIN_DENSE_SCORE=0.25
