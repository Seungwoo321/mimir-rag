# Export selected variables in the invoking process. The CLI does not load this file.
# Keep API key values in your environment or OS secret store.
MIMIR_EMBEDDING_MODEL=text-embedding-3-small
MIMIR_EMBEDDING_DIMENSIONS=1536
MIMIR_SYNTHESIS_PROVIDER=openai
MIMIR_SYNTHESIS_MODEL=gpt-4.1-mini
MIMIR_CHUNK_TARGET_TOKENS=450
MIMIR_CHUNK_MAX_TOKENS=700
MIMIR_CHUNK_OVERLAP_TOKENS=64
MIMIR_TOP_K=6
MIMIR_CONTEXT_TOKEN_BUDGET=6000
MIMIR_MIN_DENSE_SCORE=0.25
